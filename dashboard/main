    def append_log(self, text):
        timestamp = datetime.now().strftime("%H:%M:%S")
        entry = f"[{timestamp}] {text}"
        self.log.append(entry)
        self.log_history.append((timestamp, text))

    def toggle_theme(self):
        self.is_dark_theme = not self.is_dark_theme
        self.apply_style()

    def toggle_relay_manual(self, index):
        if not self.ser or not self.ser.is_open:
            self.append_log("⚠️ Hardware connection offline. Connect to COM port first.")
            return

        next_states = list(self.current_relay_states)
        next_states[index] = not next_states[index]
        
        payload_bits = ["1" if s else "0" for s in next_states]
        cmd_str = f"CMD|{'|'.join(payload_bits)}"
        
        self.cli_input.setText(cmd_str)
        self.send_cli_command()

    def export_logs_to_csv(self):
        path, _ = QFileDialog.getSaveFileName(self, "Export Telemetry Logs", "", "CSV Files (*.csv)")
        if path:
            try:
                with open(path, mode='w', newline='', encoding='utf-8') as f:
                    writer = csv.writer(f)
                    writer.writerow(["Timestamp", "Event / Command"])
                    writer.writerows(self.log_history)
                QMessageBox.information(self, "Export Successful", f"Logs exported to {path}")
            except Exception as e:
                QMessageBox.critical(self, "Export Failed", str(e))

    def make_card(self, title, value_widget, tag=""):
        box = QGroupBox(title)
        layout = QVBoxLayout(box)
        layout.setContentsMargins(15, 15, 15, 15)
        
        top_row = QHBoxLayout()
        value_widget.setAlignment(Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter)
        value_widget.setFont(QFont("Segoe UI", 20, QFont.Weight.Bold))
        top_row.addWidget(value_widget)
        
        if tag:
            tag_lbl = QLabel(tag)
            tag_lbl.setStyleSheet("color: #A3E635; font-weight: bold; font-size: 8pt; background: rgba(163, 230, 53, 0.1); border-radius: 4px; padding: 3px 6px;")
            top_row.addStretch()
            top_row.addWidget(tag_lbl)
            
        layout.addLayout(top_row)
        return box

