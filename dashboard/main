class SerialReader(QThread):
    data_received = pyqtSignal(str)

    def __init__(self, ser):
        super().__init__()
        self.ser = ser
        self.running = True

    def run(self):
        while self.running:
            try:
                if self.ser and self.ser.in_waiting:
                    line = self.ser.readline().decode(errors='ignore').strip()
                    if line:
                        self.data_received.emit(line)
            except:
                pass

    def stop(self):
        self.running = False


class MiniWaveformChart(QWidget):
    def __init__(self):
        super().__init__()
        self.data_points = [0] * 30
        self.setMinimumHeight(240)

    def add_point(self, value):
        self.data_points.pop(0)
        self.data_points.append(value)
        self.update()

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        painter.fillRect(self.rect(), QColor("#090A0D"))
        
        painter.setPen(QPen(QColor("#1E232B"), 1, Qt.PenStyle.DashLine))
        w, h = self.width(), self.height()
        for i in range(1, 6):
            painter.drawLine(int(w * i / 6), 10, int(w * i / 6), h - 10)
            painter.drawLine(10, int(h * i / 6), w - 10, int(h * i / 6))

        if not self.data_points:
            return

        path = QPainterPath()
        max_val = 100
        step_x = w / (len(self.data_points) - 1)
        
        start_y = h - 10 - ((self.data_points[0] / max_val) * (h - 20))
        path.moveTo(0, start_y)
        
        for idx, val in enumerate(self.data_points):
            x = idx * step_x
            y = h - 10 - ((val / max_val) * (h - 20))
            path.lineTo(x, y)
            
        painter.setPen(QPen(QColor("#A3E635"), 2.5, Qt.PenStyle.SolidLine))
        painter.drawPath(path)


class GlowSliderWidget(QWidget):
    valueChanged = pyqtSignal(int)

    def __init__(self, label=""):
        super().__init__()
        self.value = 0 
        self.setMinimumSize(220, 180)
        self.setCursor(Qt.CursorShape.SplitVCursor)
        self.dragging = False

        self.padding_top = 25
        self.padding_bottom = 25
        self.line_x = 75 

    def set_value(self, total_seconds):
        if total_seconds < 0:
            total_seconds = 0
        if self.value != total_seconds:
            self.value = total_seconds
            self.valueChanged.emit(self.value)
            self.update()

    def get_value(self):
        return self.value

    def _val_to_ratio(self):
        if self.value == 0:
            return 1.0
        if self.value <= 60:
            return (self.value / 60.0) * 0.5
        else:
            minutes = self.value / 60.0
            minutes = min(60.0, minutes)
            return 0.5 + ((minutes - 1.0) / 59.0) * 0.45

    def _ratio_to_val(self, ratio):
        if ratio >= 0.96:
            return 0
        if ratio <= 0.5:
            secs = int((ratio / 0.5) * 60)
            return secs
        else:
            norm_ratio = (ratio - 0.5) / 0.45
            minutes = 1 + int(norm_ratio * 59)
            minutes = min(60, minutes)
            return minutes * 60

    def _val_to_y(self):
        usable_h = self.height() - self.padding_top - self.padding_bottom
        ratio = self._val_to_ratio()
        return self.height() - self.padding_bottom - int(ratio * usable_h)

    def _y_to_val(self, y):
        usable_h = self.height() - self.padding_top - self.padding_bottom
        raw_ratio = (self.height() - self.padding_bottom - y) / usable_h
        ratio = max(0.0, min(1.0, raw_ratio))
        return self._ratio_to_val(ratio)

    def mousePressEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton:
            self.dragging = True
            self.set_value(self._y_to_val(event.position().y()))

    def mouseMoveEvent(self, event):
        if self.dragging:
            self.set_value(self._y_to_val(event.position().y()))

    def mouseReleaseEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton:
            self.dragging = False

    def paintEvent(self, event):
        painter = QPainter(self)
        painter.setRenderHint(QPainter.RenderHint.Antialiasing)
        
        w, h = self.width(), self.height()
        slider_y = self._val_to_y()
        usable_h = h - self.padding_top - self.padding_bottom

        scale_points = [
            (0.0, "0s"), (0.125, "15s"), (0.25, "30s"), (0.375, "45s"), (0.5, "60s"),
            (0.6125, "15m"), (0.725, "30m"), (0.8375, "45m"), (0.95, "60m"), (1.0, "∞")
        ]

        for ratio, text in scale_points:
            ty = h - self.padding_bottom - int(ratio * usable_h)
            painter.setPen(QPen(QColor("#475569" if text == "∞" or "0" in text or "60" in text else "#1E293B"), 1.2))
            painter.drawLine(self.line_x - 15, ty, self.line_x - 8, ty)
            
            painter.setPen(QColor("#475569" if text != "∞" else "#A3E635"))
            painter.setFont(QFont("Segoe UI", 7 if text != "∞" else 9, QFont.Weight.Bold if text == "∞" else QFont.Weight.Normal))
            painter.drawText(QRect(self.line_x - 52, ty - 9, 32, 18), Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter, text)

        line_path = QPainterPath()
        line_path.moveTo(self.line_x, self.padding_top)
        
        curve_radius = 45
        curve_depth = 12
        y_start_curve = slider_y - curve_radius
        y_end_curve = slider_y + curve_radius
        
        if y_start_curve > self.padding_top:
            line_path.lineTo(self.line_x, y_start_curve)
            
        line_path.cubicTo(
            self.line_x, slider_y - (curve_radius / 2),
            self.line_x + curve_depth, slider_y - (curve_radius / 3),
            self.line_x + curve_depth, slider_y
        )
        line_path.cubicTo(
            self.line_x + curve_depth, slider_y + (curve_radius / 3),
            self.line_x, slider_y + (curve_radius / 2),
            self.line_x, y_end_curve
        )
        
        if y_end_curve < h - self.padding_bottom:
            line_path.lineTo(self.line_x, h - self.padding_bottom)

        glow_gradient = QRadialGradient(QPointF(self.line_x, slider_y), curve_radius)
        glow_gradient.setColorAt(0.0, QColor(163, 230, 53, 55)) 
        glow_gradient.setColorAt(0.6, QColor(163, 230, 53, 15))
        glow_gradient.setColorAt(1.0, QColor(0, 0, 0, 0))
        painter.setBrush(QBrush(glow_gradient))
        painter.setPen(Qt.PenStyle.NoPen)
        painter.drawEllipse(QPoint(self.line_x - 10, slider_y), curve_radius, curve_radius)

        painter.setBrush(Qt.BrushStyle.NoBrush)
        painter.setPen(QPen(QColor("#A3E635"), 2.2, Qt.PenStyle.SolidLine))
        painter.drawPath(line_path)

        knob_center = QPoint(self.line_x + curve_depth, slider_y)
        knob_radius = 16
        
        painter.setBrush(QBrush(QColor("#0F1115")))
        painter.setPen(QPen(QColor("#2A313C"), 2))
        painter.drawEllipse(knob_center, knob_radius, knob_radius)
        
        painter.setBrush(QBrush(QColor("#1E232B")))
        painter.setPen(Qt.PenStyle.NoPen)
        painter.drawEllipse(knob_center, knob_radius - 3, knob_radius - 3)

        painter.setPen(QPen(QColor("#A3E635"), 2, Qt.PenStyle.SolidLine))
        painter.drawLine(knob_center.x() - 3, knob_center.y() - 2, knob_center.x(), knob_center.y() - 5)
        painter.drawLine(knob_center.x(), knob_center.y() - 5, knob_center.x() + 3, knob_center.y() - 2)
        painter.drawLine(knob_center.x() - 3, knob_center.y() + 2, knob_center.x(), knob_center.y() + 5)
        painter.drawLine(knob_center.x(), knob_center.y() + 5, knob_center.x() + 3, knob_center.y() + 2)

        painter.setPen(QColor("#A3E635" if self.value > 0 else "#475569"))
        if self.value == 0:
            display_str = "∞"
            unit_str = ""
        elif self.value < 60:
            display_str = str(self.value)
            unit_str = "sec"
        else:
            display_str = str(int(self.value // 60))
            unit_str = "min"

        painter.setFont(QFont("Segoe UI", 42, QFont.Weight.Light))
        text_rect = QRect(self.line_x + curve_depth + 20, 0, 110, h)
        painter.drawText(text_rect, Qt.AlignmentFlag.AlignLeft | Qt.AlignmentFlag.AlignVCenter, display_str)
        
        if unit_str:
            painter.setFont(QFont("Segoe UI", 12, QFont.Weight.Medium))
            painter.setPen(QColor("#94A3B8"))
            metrics = QFontMetrics(QFont("Segoe UI", 42, QFont.Weight.Light))
            text_w = metrics.horizontalAdvance(display_str)
            unit_rect = QRect(self.line_x + curve_depth + 25 + text_w, (h // 2) + 8, 50, 30)
            painter.drawText(unit_rect, Qt.AlignmentFlag.AlignLeft, unit_str)


class InteractiveRelayCard(QFrame):
    toggled = pyqtSignal(int)

    def __init__(self, channel_idx, title):
        super().__init__()
        self.channel_idx = channel_idx
        self.is_on = False
        
        self.setObjectName("RelayControlCard")
        self.setMinimumHeight(150)
        
        layout = QVBoxLayout(self)
        layout.setContentsMargins(16, 16, 16, 16)
        layout.setSpacing(10)

        top_row = QHBoxLayout()
        self.title_lbl = QLabel(title)
        self.title_lbl.setStyleSheet("font-weight: bold; font-size: 11pt; color: #F8FAFC;")
        
        self.status_badge = QLabel("OFF")
        self.status_badge.setObjectName("BadgeOff")
        self.status_badge.setAlignment(Qt.AlignmentFlag.AlignCenter)
        self.status_badge.setFixedSize(50, 22)
        
        top_row.addWidget(self.title_lbl)
        top_row.addStretch()
        top_row.addWidget(self.status_badge)
        layout.addLayout(top_row)

        self.info_lbl = QLabel("State: Idle (0s)")
        self.info_lbl.setStyleSheet("color: #64748B; font-size: 8.5pt;")
        layout.addWidget(self.info_lbl)

        self.btn_toggle = QPushButton("POWER ON")
        self.btn_toggle.setObjectName("RelayOffBtn")
        self.btn_toggle.setFixedHeight(38)
        self.btn_toggle.setCursor(Qt.CursorShape.PointingHandCursor)
        self.btn_toggle.clicked.connect(lambda: self.toggled.emit(self.channel_idx))
        layout.addWidget(self.btn_toggle)

    def set_state(self, state: bool, info_str=""):
        self.is_on = state
        if info_str:
            self.info_lbl.setText(info_str)
            
        if self.is_on:
            self.status_badge.setText("ACTIVE")
            self.status_badge.setObjectName("BadgeOn")
            self.btn_toggle.setText("POWER OFF")
            self.btn_toggle.setObjectName("RelayOnBtn")
            self.setProperty("active", True)
        else:
            self.status_badge.setText("OFF")
            self.status_badge.setObjectName("BadgeOff")
            self.btn_toggle.setText("POWER ON")
            self.btn_toggle.setObjectName("RelayOffBtn")
            self.setProperty("active", False)

        self.status_badge.setStyle(self.status_badge.style())
        self.btn_toggle.setStyle(self.btn_toggle.style())
        self.setStyle(self.style())


