    def refresh_ports(self):
        self.port_combo.clear()
        ports = serial.tools.list_ports.comports()
        for p in ports:
            self.port_combo.addItem(p.device)

    def toggle_connection(self):
        if self.ser:
            self.reader.stop()
            self.reader.wait()
            self.ser.close()
            self.ser = None
            self.connect_btn.setText("Connect")
            self.connect_btn.setObjectName("PrimaryButton")
            self.connect_btn.setStyle(self.connect_btn.style())
            self.status_label.setText("OFFLINE")
            self.status_label.setStyleSheet("color: #EF4444; font-weight: bold; font-size: 16pt;")
            return

        try:
            port = self.port_combo.currentText()
            if not port: return
            self.ser = serial.Serial(port, 115200, timeout=1)
            self.reader = SerialReader(self.ser)
            self.reader.data_received.connect(self.process_line)
            self.reader.start()

            self.connect_btn.setText("Disconnect")
            self.connect_btn.setObjectName("SecondaryButton")
            self.connect_btn.setStyle(self.connect_btn.style())
            self.status_label.setText("ONLINE")
            self.status_label.setStyleSheet("color: #A3E635; font-weight: bold; font-size: 16pt;")
            self.append_log(f"📡 System interface connected to base hardware port {port}")
            
            # Send Auto Anti-Replay Sync Frame to hardware
            QTimer.singleShot(100, lambda: self.ser.write(b"SYNC\n"))
        except Exception as e:
            QMessageBox.critical(self, "Hardware Interface Error", str(e))

    def update_interlock_group_rules(self):
        self.interlocked_indices = []
        for idx, btn in enumerate(self.selector_buttons):
            if btn.isChecked():
                self.interlocked_indices.append(idx)

    def reset_all_interlock_rules(self):
        for btn in self.selector_buttons:
            btn.blockSignals(True)
            btn.setChecked(False)
            btn.blockSignals(False)
        
        self.interlocked_indices = []
        self.interlock_status_lbl.setText("🛡️ SAFETY INTERLOCKS ACTIVE — NO ACTIVE VIOLATIONS")
        self.interlock_status_lbl.setStyleSheet("color: #34D399; padding: 12px; background: #064E3B; border-radius: 6px;")
        self.append_log("🔓 User Action: All selection zones wiped to Normal.")

    def update_relay_timeout_limit(self, relay_idx, total_seconds):
        self.relay_time_limits[relay_idx] = total_seconds
        if total_seconds == 0:
            self.relay_time_elapsed[relay_idx] = 0
            self.progress_bars[relay_idx].setValue(0)
            self.progress_bars[relay_idx].setFormat("Continuous (∞)")

    def process_relay_timeouts(self):
        command_needed = False
        next_command_bits = ["0", "0", "0", "0"]

        for i in range(4):
            if self.current_relay_states[i]:
                limit = self.relay_time_limits[i]
                next_command_bits[i] = "1"
                
                if limit > 0:
                    self.relay_time_elapsed[i] += 1
                    elapsed = self.relay_time_elapsed[i]
                    
                    percentage = int((elapsed / limit) * 100)
                    self.progress_bars[i].setValue(min(100, percentage))
                    
                    if limit < 60:
                        lbl_text = f"RUNNING ({elapsed}/{limit}s)"
                        self.progress_bars[i].setFormat(lbl_text)
                        self.relay_cards[i].set_state(True, lbl_text)
                    else:
                        elapsed_m, elapsed_s = divmod(elapsed, 60)
                        limit_m = limit // 60
                        lbl_text = f"RUNNING ({elapsed_m}m {elapsed_s}s / {limit_m}m)"
                        self.progress_bars[i].setFormat(lbl_text)
                        self.relay_cards[i].set_state(True, lbl_text)
                    
                    if elapsed >= limit:
                        limit_text = f"{limit}s" if limit < 60 else f"{limit // 60}m"
                        self.append_log(f"⏱️ TIMEOUT FAULT: Relay Node 0{i+1} ran past safety limit of {limit_text}!")
                        next_command_bits[i] = "0"
                        command_needed = True
                else:
                    self.progress_bars[i].setValue(0)
                    self.progress_bars[i].setFormat("Continuous (∞)")
                    self.relay_cards[i].set_state(True, "Continuous (∞)")
            else:
                self.relay_time_elapsed[i] = 0
                self.progress_bars[i].setValue(0)
                limit = self.relay_time_limits[i]
                if limit > 0:
                    lbl_text = f"Ready ({limit}s max)" if limit < 60 else f"Ready ({limit // 60}m max)"
                    self.progress_bars[i].setFormat(lbl_text)
                    self.relay_cards[i].set_state(False, lbl_text)
                else:
                    self.progress_bars[i].setFormat("Idle")
                    self.relay_cards[i].set_state(False, "Idle")

        if command_needed and self.ser and self.ser.is_open:
            payload = f"CMD|{next_command_bits[0]}|{next_command_bits[1]}|{next_command_bits[2]}|{next_command_bits[3]}\n"
            try:
                self.ser.write(payload.encode())
                self.append_log(f"⚠️ AUTOMATED SAFETY CUTOFF SENT -> {payload.strip()}")
            except Exception as e:
                self.append_log(f"❌ Failed to execute automated timed safety payload: {str(e)}")

    def trigger_hardware_safety_trip(self, custom_msg):
        for card in self.relay_cards:
            card.set_state(False, "Emergency Stop")
            
        self.interlock_status_lbl.setText(f"🚨 FAULT: {custom_msg}")
        self.interlock_status_lbl.setStyleSheet("color: #F8FAFC; padding: 12px; background: #991B1B; border-radius: 6px;")
        
        if self.ser and self.ser.is_open:
            try:
                self.ser.write(b"CMD|0|0|0|0\n")
                self.append_log("⚠️ SAFETY OVERRIDE SENT: Broadcasted emergency shutdown frame -> CMD|0|0|0|0")
            except Exception as e:
                self.append_log(f"❌ Failed to transmit emergency trip packet: {str(e)}")

    def send_cli_command(self):
        if not self.ser:
            self.append_log("⚠️ Execution failed: Connection offline.")
            return
        raw_text = self.cli_input.text().strip()
        if not raw_text: return
        
        if raw_text.startswith("CMD|"):
            if raw_text.endswith("|") or "||" in raw_text:
                self.append_log(f"❌ EXECUTION REJECTED [FAULT]: Incomplete array detected: '{raw_text}'")
                self.trigger_hardware_safety_trip("CLI PACKET CONTAINS MISSING INDICES")
                self.cli_input.clear()
                return

            tokens = raw_text.split("|")[1:]
            if len(tokens) != 4 or "" in tokens or any(t.isspace() for t in tokens):
                self.append_log(f"❌ EXECUTION REJECTED [FAULT]: Tokens must match 4 binary states: '{raw_text}'")
                self.trigger_hardware_safety_trip("INVALID BIT FRAME PATTERN LENGTH")
                self.cli_input.clear()
                return
                
            if len(self.interlocked_indices) >= 2:
                active_violations_found = 0
                violated_channels = []
                
                for idx in self.interlocked_indices:
                    if tokens[idx] == "1":
                        active_violations_found += 1
                        violated_channels.append(str(idx + 1))
                
                if active_violations_found > 1:
                    channels_str = ", ".join(violated_channels)
                    self.append_log(f"❌ INTERLOCK BLOCKED: Relays ({channels_str}) are grouped in an exclusion rule set!")
                    self.trigger_hardware_safety_trip(f"GROUP CONSTRAINT HAZARD (Relays: {channels_str})")
                    self.cli_input.clear()
                    return

        try:
            self.ser.write((raw_text + "\n").encode())
            self.append_log(f"⌨️ CLI Executed Payload Send: {raw_text}")
            self.cli_input.clear()
        except Exception as e:
            self.append_log(f"⚠️ CLI Error: {str(e)}")

    def process_line(self, line):
        self.append_log(f"📥 {line}")
        
        if "RELAYS:" in line or "RSSI:" in line:
            self.packet_count += 1
            self.packet_label.setText(str(self.packet_count))

        if line.startswith("RSSI:"):
            try:
                rssi = int(line.replace("RSSI:", ""))
                self.rssi_label.setText(f"{rssi} dBm")
                strength = max(0, min(100, rssi + 120))
                self.waveform.add_point(strength)
            except:
                pass

        if line.startswith("RELAYS:"):
            raw_payload = line.replace("RELAYS:", "")
            
            if raw_payload.endswith(",") or ",," in raw_payload:
                self.append_log("⚠️ INTERLOCK ALERT [FAULT]: Inbound frame dropped critical bits.")
                self.trigger_hardware_safety_trip("INCOMING PACKET HAS MISSING INDICES")
                return

            data = raw_payload.split(",")
            if len(data) != 4 or "" in data or any(val.isspace() for val in data):
                self.append_log("⚠️ INTERLOCK ALERT [FAULT]: Array length broke boundary thresholds.")
                self.trigger_hardware_safety_trip("INVALID INCOMING FRAME STRUCTURE")
                return

            if len(self.interlocked_indices) >= 2:
                active_violations_found = 0
                violated_channels = []
                
                for idx in self.interlocked_indices:
                    if data[idx] == "1":
                        active_violations_found += 1
                        violated_channels.append(str(idx + 1))
                        
                if active_violations_found > 1:
                    channels_str = ", ".join(violated_channels)
                    self.append_log(f"⚠️ INTERLOCK HAZARD [FAULT]: Remote unit triggered overlapping relays: ({channels_str})")
                    self.trigger_hardware_safety_trip(f"REMOTE GROUP VIOLATION (Relays: {channels_str})")
                    return

            self.interlock_status_lbl.setText("🛡️ SAFETY INTERLOCKS ACTIVE — NO ACTIVE VIOLATIONS")
            self.interlock_status_lbl.setStyleSheet("color: #34D399; padding: 12px; background: #064E3B; border-radius: 6px;")
            
            for i in range(4):
                is_active = (data[i] == "1")
                self.current_relay_states[i] = is_active
                self.relay_cards[i].set_state(is_active)


if __name__ == "__main__":
    app = QApplication(sys.argv)
    window = Dashboard()
    window.show()
    sys.exit(app.exec())
